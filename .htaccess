# ========================================================
# Bangladesh Merchant Mariners Community (BMMC)
# Apache / cPanel Configuration & Security Rules
# ========================================================

# 1. Disable directory browsing
Options -Indexes

# 2. Default charset UTF-8
AddDefaultCharset UTF-8

# 3. Protect sensitive files and directories
<FilesMatch "^\.env|database_credentials\.php|\.sqlite|maintenance\.json|\.(env|sql|log|ini|sh)$">
    Order allow,deny
    Deny from all
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Route /m or /m/ directly to m.php
    RewriteRule ^m/?$ m.php [L,QSA]

    # Block access to git or hidden files
    RewriteRule "(^|/)\.(?!well-known)" - [F]
</IfModule>

# 4. Enable gzip compression if available
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>
