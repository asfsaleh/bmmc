# ========================================================
# Bangladesh Merchant Mariners Community (BMMC)
# Apache / cPanel Configuration & Security Rules
# ========================================================

# 1. Disable directory browsing
Options -Indexes

# 2. Default charset UTF-8
AddDefaultCharset UTF-8

# 3. Protect sensitive directories and files
<FilesMatch "\.(env|sql|log|ini|sh)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# 4. Error Pages (optional)
# ErrorDocument 404 /index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Block access to git or hidden files
    RewriteRule "(^|/)\.(?!well-known)" - [F]
</IfModule>

# 5. Enable gzip compression if available
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>
