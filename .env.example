# ========================================================
# Bangladesh Merchant Mariners Community (BMMC)
# Environment Configuration Template
# ========================================================
# Live server এ এই ফাইলটি কপি করে .env নাম দিন এবং আপনার cPanel DB তথ্য বসান।
# cp .env.example .env

APP_ENV=production
APP_DOMAIN=bmmc.skillsetup.org
APP_URL=https://bmmc.skillsetup.org

# Database Configuration (cPanel MySQL Database Credentials)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_cpanel_dbname
DB_USER=your_cpanel_dbuser
DB_PASS=your_strong_password
DB_CHARSET=utf8mb4

# Resting Period in Days (4 Months = 120 Days)
RESTING_PERIOD_DAYS=120

# Email / SMTP Settings
# Live এ ইমেইল চালু করতে MAIL_SIMULATE=false করুন
MAIL_SIMULATE=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=bmmc.welfare@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM_NAME="BMMC Blood Portal"
SMTP_FROM_EMAIL=bmmc.welfare@gmail.com

# Additional Admin Emails (Comma separated)
ADMIN_EMAILS=admin@bmmc.org,secretary@bmmc.org
